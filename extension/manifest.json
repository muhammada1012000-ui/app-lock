{
  "manifest_version": 3,
  "name": "App Lock",
  "version": "1.0.0",
  "description": "Lock distracting Windows apps for a set time. Needs the App Lock helper running on your PC.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "App Lock",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["http://localhost:8765/*"]
}
